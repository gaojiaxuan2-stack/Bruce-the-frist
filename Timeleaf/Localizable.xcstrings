      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@里的一个%1$@%2$@"
          }
        }
      }
    },
    "a little while" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片刻"
          }
        }
      }
    },
