    },
    "Together these memories are over %@, so this letter can't be sent to %@. You can still seal it as a keepsake, or leave out a long video to send it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些回忆合计超过%1$@，这封信无法寄给%2$@。你仍可以把它封存为珍藏，或去掉一段较长的视频再寄出。"
          }
        }
      }
    },
    "Too large to send as a file" : {
