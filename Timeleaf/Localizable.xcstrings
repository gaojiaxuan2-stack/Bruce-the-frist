    },
    "Write back to your past self" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给过去的自己回信"
          }
        }
      }
    },
    "Write to the person you are becoming." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写给你正在成为的那个人。"
          }
        }
      }
    },
    "Write to the person you will be. Choose a day, seal it, and let time carry it there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写给将来的自己。选一个日子，封存它，让时间把它送达。"
          }
        }
      }
    },
    "Write your first letter" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写下第一封信"
