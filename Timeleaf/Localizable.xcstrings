    "Your letter is halfway through its journey" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的信已走过一半旅程"
          }
        }
      }
    },
    "Your letter to %@ is halfway there" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你写给%@的信，已行至半途"
          }
        }
      }
    },
    "Your letters are resting, safe and unread." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的信正安然栖息，无人翻阅。"
          }
        }
      }
    },
    "Your name" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的名字"
          }
        }
      }
    },
    "Your vault is quiet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的信匣还很安静。"
          }
        }
      }
    },
    "Your words and the memories you added will be erased." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你写下的文字和添加的回忆都将被抹去。"
          }
        }
      }
    },
    "Your words are travelling quietly through time." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的字句，正静静穿行于时光之中。"
          }
        }
      }
    },
    "Your words, held in drifting northern light." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的字句，安放在流转的极光里。"
          }
        }
      }
    },
