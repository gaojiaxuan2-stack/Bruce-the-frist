      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给未来写下第一封信吧。"
          }
        }
      }
    },
    "Written %@ ago — on %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写于%1$@前——%2$@"
          }
