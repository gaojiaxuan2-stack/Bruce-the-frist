          }
        }
      }
    },
    "So every letter here is a leaf of time:\nwritten today, sealed with care,\nand opened only when its day arrives." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所以这里的每一封信，都是一页时光：\n写于今日，郑重封存，\n只在属于它的那天开启。"
          }
        }
      }
    },
    "Some memories couldn't be added." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些回忆没能添加进来。"
